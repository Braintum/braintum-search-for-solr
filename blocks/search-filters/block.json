{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "braintum-search/search-filters",
	"title": "Search filters",
	"category": "widgets",
	"icon": "filter",
	"description": "Filters for Solr-powered search results, built from the facets this site offers.",
	"keywords": [ "search", "filter", "facet", "solr" ],
	"textdomain": "braintum-search-for-solr",
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"facets": {
			"type": "array",
			"items": { "type": "string" },
			"default": []
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"showCounts": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "braintum-search-filters-block",
	"style": "braintum-search-filters"
}
